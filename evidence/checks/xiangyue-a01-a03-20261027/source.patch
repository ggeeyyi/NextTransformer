+"""Bounded CUDA oracle for the optional A01/A02/A03 FLA backend.
+
+Run under the job's exclusive GPU allocation, before pilot or formal training.
+This tests the recurrent operator, not a full-model update or a quality result.
+"""
+import argparse
+import json
+from pathlib import Path
+import time
+
+import torch
+from torch.nn import functional as F
+
+from .methods.linear import recurrent_attention
+from .methods.linear_backend import (SUPPORTED_METHODS, fused_recurrent_attention,
+                                     linear_backend_provenance)
+
+
+def _error(actual, expected):
+    actual, expected = actual.double(), expected.double()
+    delta = actual - expected
+    return dict(
+        finite=bool(torch.isfinite(actual).all() and torch.isfinite(expected).all()),
+        max_abs=float(delta.abs().max()),
+        normalized_max=float(delta.abs().max() / expected.abs().max().clamp_min(1e-7)),
+        normalized_rms=float(delta.square().mean().sqrt()
+                             / expected.square().mean().sqrt().clamp_min(1e-7)),
+    )
+
+
+def _flatten_states(state):
+    return tuple(state) if isinstance(state, (tuple, list)) else (state,)
+
+
+def _inputs(kind, *, batch, length, heads, dim, slots, dtype, device):
+    shape = (batch, length, heads, dim)
+    q, k, v = (torch.randn(shape, device=device) * .3 for _ in range(3))
+    if kind == "deltanet":
+        q = F.normalize(q, dim=-1) * dim ** -.5
+        k = F.normalize(k, dim=-1)
+        beta = torch.randn(batch, length, heads, device=device).sigmoid()
+        return dict(q=q.to(dtype), k=k.to(dtype), v=v.to(dtype), beta=beta.to(dtype))
+    if kind == "gla":
+        q = q * dim ** -.5
+        decay = (F.logsigmoid(torch.randn(shape, device=device)) / 16).exp()
+        return dict(q=q.to(dtype), k=k.to(dtype), v=v.to(dtype), decay=decay)
+    q, k, v = (F.silu(x) for x in (q, k, v))
+    decay = (F.logsigmoid(torch.randn(batch, length, heads, slots, device=device)) / 8).exp()
+    return dict(q=q.to(dtype), k=k.to(dtype), v=v.to(dtype), decay=decay, slots=1-decay)
+
+
+def _clone(inputs):
+    return {key: value.detach().clone().requires_grad_(True) for key, value in inputs.items()}
+
+
+def check(kind, inputs):
+    source = _clone(inputs)
+    target = _clone(inputs)
+    started = time.monotonic()
+    expected, expected_state = recurrent_attention(**source, kind=kind)
+    actual, actual_state = fused_recurrent_attention(**target, kind=kind, output_final_state=True)
+    output_error = _error(actual, expected)
+    actual_states, expected_states = _flatten_states(actual_state), _flatten_states(expected_state)
+    if len(actual_states) != len(expected_states):
+        raise RuntimeError('fused/reference final-state counts differ')
+    state_errors = [_error(a, b) for a, b in zip(actual_states, expected_states)]
+    # Final state is checked numerically but is not part of the training loss.
+    upstream = torch.randn_like(actual)
+    (expected.float() * upstream.float()).sum().backward()
+    (actual.float() * upstream.float()).sum().backward()
+    grad_errors = {}
+    for key in source:
+        if source[key].grad is None or target[key].grad is None:
+            raise RuntimeError("missing gradient for " + key)
+        grad_errors[key] = _error(target[key].grad, source[key].grad)
+
+    # Carrying state between pieces must reproduce the whole row. Carry is
+    # solely an oracle exercise; the production model resets each packed row.
+    midpoint = inputs["q"].shape[1] // 2
+    with torch.no_grad():
+        left = {key: value[:, :midpoint].contiguous() for key, value in inputs.items()}
+        right = {key: value[:, midpoint:].contiguous() for key, value in inputs.items()}
+        first, state = fused_recurrent_attention(**left, kind=kind, output_final_state=True)
+        second, _ = fused_recurrent_attention(**right, kind=kind, initial_state=state,
+                                              output_final_state=True)
+        carried_error = _error(torch.cat((first, second), dim=1), actual.detach())
+        changed = {key: value.clone() for key, value in inputs.items()}
+        for key, value in changed.items():
+            value[:, midpoint:] = inputs[key][:, midpoint:].flip(1)
+        changed_output, _ = fused_recurrent_attention(**changed, kind=kind)
+        causal_error = float((changed_output[:, :midpoint] - actual.detach()[:, :midpoint]).abs().max())
+        separate, _ = fused_recurrent_attention(
+            **{key: value[:1].contiguous() for key, value in inputs.items()}, kind=kind)
+        row_error = float((separate - actual.detach()[:1]).abs().max())
+
+    low_precision = inputs["q"].dtype in (torch.bfloat16, torch.float16)
+    # Fixed before pilot: BF16 gradients differ at rounding boundaries. Report
+    # both normalized metrics; never adjust thresholds based on quality/CORE.
+    rms_limit, max_limit = (.015, .06) if low_precision else (.001, .005)
+    errors = [output_error, *state_errors, carried_error, *grad_errors.values()]
+    passed = (all(value["finite"] and value["normalized_rms"] <= rms_limit
+                  and value["normalized_max"] <= max_limit for value in errors)
+              and causal_error == 0 and row_error == 0)
+    torch.cuda.synchronize()
+    return dict(method=kind, dtype=str(inputs["q"].dtype), shape=list(inputs["q"].shape),
+                output=output_error, states=state_errors, gradients=grad_errors,
+                carried_state=carried_error, causal_max_abs=causal_error,
+                row_reset_max_abs=row_error, rms_limit=rms_limit, max_limit=max_limit,
+                elapsed_seconds=time.monotonic()-started, passed=passed)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--methods", nargs="+", choices=SUPPORTED_METHODS, default=list(SUPPORTED_METHODS))
+    parser.add_argument("--lengths", type=int, nargs="+", default=[32, 128, 2048])
+    parser.add_argument("--heads", type=int, default=12)
+    parser.add_argument("--dim", type=int, default=128)
+    parser.add_argument("--slots", type=int, default=64)
+    parser.add_argument("--batch", type=int, default=2)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if any(length < 2 for length in args.lengths):
+        raise ValueError("oracle lengths must be at least two")
+    if not torch.cuda.is_available():
+        raise RuntimeError("this is a CUDA kernel oracle; no CPU fallback")
+    torch.manual_seed(42)
+    result = dict(scope="recurrent_operator_oracle_not_full_model_training",
+                  backend=linear_backend_provenance("fla_fused"),
+                  device=torch.cuda.get_device_name(), results=[])
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    for kind in args.methods:
+        for length in args.lengths:
+            for dtype in (torch.float32, torch.bfloat16):
+                inputs = _inputs(kind, batch=args.batch, length=length, heads=args.heads,
+                                 dim=args.dim, slots=args.slots, dtype=dtype, device="cuda")
+                item = check(kind, inputs)
+                result["results"].append(item)
+                result["passed"] = all(row["passed"] for row in result["results"])
+                args.output.write_text(json.dumps(result, indent=2)+"\n")
+                print(json.dumps(item), flush=True)
+                if not item["passed"]:
+                    raise RuntimeError("FLA recurrent output/state/gradient oracle failed")
+
+
+if __name__ == "__main__":
+    main()
