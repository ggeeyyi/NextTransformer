+"""Eight-rank A01/A02/A03 training with a frozen input and evaluation budget.
+
+Example: torchrun --standalone --nproc-per-node=8 -m reference.train
+  --config reference/configs/deltanet.json --site-config site.local.json
+  --output /persistent/runs/A01 --micro-batch 8
+
+Smoke and pilot outputs are permanently distinct from formal experiments.
+Only a calibrated backend can enter formal training. All training data cursor,
+optimizer, random state and cumulative cost are checkpointed together.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import nullcontext
+from dataclasses import asdict, replace
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import sys
+import time
+
+from .config import Protocol, load_config
+
+SUPPORTED_METHODS = ("deltanet", "gsa", "gla")
+
+
+def digest_json(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
+
+
+def initialize(seed):
+    """Native seed/TF32 recipe with explicit rank-device NCCL initialization."""
+    from datetime import timedelta
+    import random
+    import numpy as np
+    import torch
+    import torch.distributed as dist
+    world = int(os.environ.get("WORLD_SIZE", "1"))
+    rank = int(os.environ.get("RANK", "0"))
+    local_rank = int(os.environ.get("LOCAL_RANK", "0"))
+    device = torch.device("cuda", local_rank) if torch.cuda.is_available() else torch.device("cpu")
+    if device.type == "cuda":
+        torch.cuda.set_device(device)
+        torch.backends.cuda.matmul.allow_tf32 = True
+        torch.backends.cudnn.allow_tf32 = True
+    if world > 1:
+        options = dict(timeout=timedelta(minutes=10))
+        if device.type == "cuda":
+            dist.init_process_group("nccl", device_id=device, **options)
+        else:
+            dist.init_process_group("gloo", **options)
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if device.type == "cuda":
+        torch.cuda.manual_seed_all(seed)
+    return rank, world, device
+
+
+def precision_policy(model):
+    """Concrete runtime precision is part of resume and campaign identity."""
+    import torch
+    from nanochat.common import COMPUTE_DTYPE
+    return dict(training_autocast_dtype=str(torch.bfloat16), native_compute_dtype=str(COMPUTE_DTYPE),
+                cuda_matmul_allow_tf32=bool(torch.backends.cuda.matmul.allow_tf32),
+                cudnn_allow_tf32=bool(torch.backends.cudnn.allow_tf32),
+                float32_matmul_precision=torch.get_float32_matmul_precision(),
+                input_embedding_dtype=str(model.transformer.wte.weight.dtype),
+                unembedding_dtype=str(model.lm_head.weight.dtype),
+                parameter_dtypes=sorted({str(param.dtype) for param in model.parameters()}),
+                gradient_reduction="DDP average in each parameter gradient dtype",
+                gradient_scaler=False)
+
+
+def run_mode(smoke_steps=0, pilot_steps=0):
+    if smoke_steps < 0 or pilot_steps < 0 or (smoke_steps and pilot_steps):
+        raise ValueError("choose one nonnegative smoke or pilot step limit")
+    limit = smoke_steps or pilot_steps
+    if limit >= Protocol().steps:
+        raise ValueError("bounded checks must stop before the formal training budget")
+    return "smoke" if smoke_steps else "pilot" if pilot_steps else "formal"
+
+
+def static_update_cost(config, proof):
+    """The proof is one complete GLOBAL update, including optimizer once.
+
+    Never multiply it by the number of ranks or accumulation microsteps.
+    Only the three static, joint-training linear methods are supported here.
+    """
+    if config.method not in SUPPORTED_METHODS:
+        raise ValueError("this trainer only admits A01 DeltaNet, A02 GSA and A03 GLA")
+    p = Protocol()
+    if (proof.get("method") != config.method or proof.get("model_hash") != config.fingerprint
+            or proof.get("protocol_hash") != p.fingerprint or proof.get("unknown")):
+        raise ValueError("cost proof does not cover the actual method/model/protocol")
+    stages = proof.get("stages", [])
+    if len(stages) != 1 or stages[0].get("stage") != "joint" or stages[0].get("depth") is not None:
+        raise ValueError("static linear training requires one audited joint stage")
+    stage = stages[0]
+    cost = stage["cost"]
+    total = cost["total"]
+    if type(total) is not int or total <= 0 or stage["optimizer_steps"] != p.steps:
+        raise ValueError("invalid static cost/stage coverage")
+    if proof["total_training_flops"] != total * p.steps:
+        raise ValueError("cumulative cost is not the sum of complete global updates")
+    if cost.get("sequence_len", p.sequence_len) != p.sequence_len:
+        raise ValueError("audited context length differs")
+    phases = cost.get("phases", {})
+    if set(phases) != {"forward", "backward", "optimizer"} or sum(phases.values()) != total:
+        raise ValueError("cost proof must cover forward, backward and optimizer")
+    return total
+
+
+def make_plan(config, proof, micro_batch, world=8, *, smoke_steps=0, pilot_steps=0,
+              backend=None):
+    p = Protocol()
+    if config.method not in SUPPORTED_METHODS or config.scale != "formal":
+        raise ValueError("only full-dimension A01/A02/A03 configurations are supported")
+    mode = run_mode(smoke_steps, pilot_steps)
+    accumulation = p.accumulation(micro_batch, world)
+    actual_backend = backend or config.backend
+    if mode == "formal" and actual_backend != config.backend:
+        raise ValueError("runtime backend must equal the calibrated model configuration")
+    cost = static_update_cost(config, proof) if proof is not None else None
+    if mode == "formal" and cost is None:
+        raise ValueError("formal training requires an admitted theoretical cost proof")
+    limit = smoke_steps or pilot_steps or p.steps
+    return dict(method=config.method, mode=mode, backend=actual_backend,
+                optimizer_steps=limit, formal_optimizer_steps=p.steps,
+                global_batch_tokens=p.global_batch_tokens, total_input_tokens=limit*p.global_batch_tokens,
+                sequence_len=p.sequence_len, world_size=world, micro_batch=micro_batch,
+                accumulation=accumulation, rows_per_rank=p.global_batch_tokens//world//p.sequence_len,
+                theory_flops_per_update=cost, theory_total_flops=None if cost is None else cost*limit,
+                cost_admitted=proof is not None,
+                validation_steps=list(p.validation_steps) if mode == "formal" else [0, limit],
+                core_steps=list(p.core_steps) if mode == "formal" else [],
+                final_bpb_tokens=p.final_bpb_tokens if mode == "formal" else None,
+                protocol_hash=p.fingerprint, model_hash=config.fingerprint)
+
+
+def check_cursor(budget, rows, world, update_cost, *, complete_events=True):
+    """Check exact global input order and theory history before any resumed update."""
+    p = Protocol()
+    budget.validate()
+    if rows*world*p.sequence_len != budget.input_tokens:
+        raise ValueError("rank-local best-fit row cursor differs from the token budget")
+    if update_cost is not None and budget.theory_flops != budget.optimizer_step*update_cost:
+        raise ValueError("cumulative theory cost differs from the audited update history")
+    if complete_events:
+        for actual, expected in ((budget.val_steps, p.validation_steps), (budget.core_steps, p.core_steps)):
+            # The current checkpoint can precede a scheduled evaluation, but
+            # events strictly before it can never be skipped.
+            if [s for s in actual if s < budget.optimizer_step] != [s for s in expected if s < budget.optimizer_step]:
+                raise ValueError("checkpoint omits an earlier mandatory evaluation")
+
+
+def validate_core_result(result):
+    if not result.get("full_core") or result.get("expected_tasks") != Protocol().core_tasks:
+        raise ValueError("CORE was not run with the full frozen task pool")
+    if result.get("protocol_hash") != Protocol().fingerprint:
+        raise ValueError("CORE protocol fingerprint differs")
+    a, b = result.get("results", {}), result.get("centered_results", {})
+    if len(a) != 22 or set(a) != set(b):
+        raise ValueError("CORE must contain all 22 task results")
+    if not all(math.isfinite(float(x)) for x in [*a.values(), *b.values(), result["core_metric"]]):
+        raise ValueError("nonfinite CORE result")
+
+
+def runtime_source_manifest():
+    """Extend the native fingerprint to include this trainer and reference code."""
+    from nanochat.experiment.runtime import source_manifest
+    from nanochat.experiment.data import sha256
+    manifest = source_manifest()
+    root = Path(__file__).resolve().parents[1]
+    for path in sorted((root/"reference").rglob("*.py")):
+        if not set(path.parts) & {"tests", "__pycache__"}:
+            manifest["files"][str(path.relative_to(root))] = sha256(path)
+    manifest["sha256"] = digest_json(manifest["files"])
+    return manifest
+
+
+def archive_replay(output, step):
+    """Keep evidence of superseded work while replaying a committed checkpoint."""
+    output = Path(output)
+    archive = output/"replayed_events"/str(time.time_ns())
+    metrics = output/"metrics.jsonl"
+    if metrics.exists():
+        kept, replayed = [], []
+        for line in metrics.read_text().splitlines():
+            try:
+                target = kept if json.loads(line).get("step", 0) <= step else replayed
+            except (ValueError, TypeError):
+                target = replayed
+            target.append(line)
+        if replayed:
+            archive.mkdir(parents=True, exist_ok=True)
+            (archive/"metrics.jsonl").write_text("\n".join(replayed)+"\n")
+            temp = metrics.with_suffix(".jsonl.tmp")
+            temp.write_text("\n".join(kept)+("\n" if kept else "")); temp.replace(metrics)
+    for pattern in ("val_*.json", "core_*.json", "smoke_bpb_*.json", "pilot_bpb_*.json"):
+        for path in output.glob(pattern):
+            tail = path.stem.rsplit("_", 1)[-1]
+            if tail.isdigit() and int(tail) > step:
+                archive.mkdir(parents=True, exist_ok=True); path.rename(archive/path.name)
+    names = ("run_status.json",) if step == Protocol().steps else ("core_final.json", "bpb_final.json", "run_status.json")
+    for name in names:
+        path = output/name
+        if path.exists():
+            archive.mkdir(parents=True, exist_ok=True); path.rename(archive/name)
+    # A crashed atomic checkpoint has no completion manifest and is never used.
+    for path in output.glob("checkpoint_[0-9]*"):
+        if path.is_dir() and not (path/"complete.json").exists():
+            archive.mkdir(parents=True, exist_ok=True); path.rename(archive/path.name)
+
+
+def parse_args(argv=None):
+    from nanochat.experiment.site import add_runtime_arguments
+    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
+    add_runtime_arguments(parser)
+    parser.add_argument("--config", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--backend", choices=("reference", "fla_fused"))
+    parser.add_argument("--resume", type=Path)
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--smoke-steps", type=int, default=0)
+    parser.add_argument("--pilot-steps", type=int, default=0)
+    parser.add_argument("--uncalibrated-pilot", action="store_true",
+                        help="pilot only: explicit backend feasibility check without any admitted cost claim")
+    parser.add_argument("--smoke-val-tokens", type=int, default=0)
+    parser.add_argument("--log-every", type=int, default=10)
+    parser.add_argument("--checkpoint-every", type=int, default=5000,
+                        help="frozen at 5000 for formal; bounded runs also save at their stop")
+    parser.add_argument("--world-size", type=int, default=8, help="planning only; actual size comes from torchrun")
+    args = parser.parse_args(argv)
+    args.micro_batch = args.micro_batch or 8
+    mode = run_mode(args.smoke_steps, args.pilot_steps)
+    if args.log_every < 1 or args.checkpoint_every != 5000:
+        parser.error("log frequency must be positive; checkpoint interval is frozen at 5000")
+    if args.uncalibrated_pilot and mode != "pilot":
+        parser.error("--uncalibrated-pilot requires --pilot-steps")
+    if args.smoke_val_tokens < 0 or (args.smoke_val_tokens and mode == "formal"):
+        parser.error("evaluation token override is only allowed for explicit bounded checks")
+    return args
+
+
+def main(argv=None):
+    # Site resolution precedes torch, tokenizer and external kernel imports.
+    from nanochat.experiment.site import bootstrap_runtime
+    bootstrap_runtime(argv)
+    args = parse_args(argv)
+    import torch
+    import torch.distributed as dist
+    from torch.nn.parallel import DistributedDataParallel as DDP
+    from nanochat.experiment.data import atomic_json, sha256
+    from nanochat.experiment.runtime import autocast, synchronize, append_event, rng_state, restore_rng
+    from nanochat.native_experiment.config import NativeTrainConfig
+    from nanochat.native_experiment.checkpoint import save_checkpoint, load_checkpoint
+    from nanochat.native_experiment.data import BestFitStream, verify_resources
+    from nanochat.experiment.evaluation import verify_core
+    from nanochat.tokenizer import RustBPETokenizer
+    from .model import build_model
+    from .optimizer import build_optimizer, set_schedule
+    from .protocol import admit_config, BudgetState, events_at, evaluate_bpb, evaluate_core
+
+    p = Protocol()
+    if args.uncalibrated_pilot:
+        config, proof = load_config(args.config), None
+        if args.backend is not None and args.backend != config.backend:
+            config = replace(config, backend=args.backend)
+    else:
+        config, proof = admit_config(args.config)
+    plan = make_plan(config, proof, args.micro_batch, args.world_size,
+                     smoke_steps=args.smoke_steps, pilot_steps=args.pilot_steps, backend=args.backend)
+    # Deliberately different pilot backend cannot reuse a reference cost proof.
+    if plan["backend"] != config.backend:
+        if not args.uncalibrated_pilot:
+            raise ValueError("backend differs from calibrated configuration; use an explicitly uncalibrated pilot")
+    if args.dry_run:
+        print(json.dumps(plan, indent=2)); return
+    if args.wandb_mode != "disabled":
+        raise ValueError("reference trainer currently writes local metrics; set --wandb-mode disabled")
+    if args.resources is None:
+        raise ValueError("--resources or site resources is required")
+    output = args.output.resolve()
+    data_dir = (args.data_dir or args.resources/"base_data_climbmix").resolve()
+    rank, world, device = initialize(p.seed)
+    p.accumulation(args.micro_batch, world)
+    if device.type != "cuda":
+        raise ValueError("full-dimension training requires eight CUDA ranks; use --dry-run for CPU planning")
+    from nanochat.common import COMPUTE_DTYPE
+    if COMPUTE_DTYPE != torch.bfloat16:
+        raise ValueError("the frozen native training recipe requires NANOCHAT_DTYPE=bfloat16")
+    accumulation = p.accumulation(args.micro_batch, world)
+    plan["world_size"] = world
+    run_lock = None
+    run_owned = False
+    started = time.monotonic()
+    state = None
+    model = optimizer = stream = None
+    try:
+        # Broadcast lock/preflight errors so peers never wait indefinitely at a
+        # barrier when rank zero rejects a duplicate output or bad resume.
+        error = [None]
+        if rank == 0:
+            try:
+                import fcntl
+                output.mkdir(parents=True, exist_ok=True)
+                run_lock = (output/"run.lock").open("a")
+                fcntl.flock(run_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                if (output/"provenance.json").exists() and not args.resume:
+                    raise ValueError("output already contains a run; use --resume or a new output")
+                if args.resume:
+                    if args.resume.resolve().parent != output or not (output/"provenance.json").exists():
+                        raise ValueError("exact resume requires a checkpoint in its original output directory")
+                    complete = json.loads((args.resume/"complete.json").read_text())
+                    if any(int(q.name.removeprefix("checkpoint_")) > complete["step"]
+                           for q in output.glob("checkpoint_[0-9]*")
+                           if q.is_dir() and (q/"complete.json").exists()):
+                        raise ValueError("output contains later checkpoints; select a new output")
+            except Exception as exc:
+                error[0] = str(exc)
+        dist.broadcast_object_list(error, src=0)
+        if error[0]:
+            raise ValueError(error[0])
+        run_owned = rank == 0
+        resources, manifest_hash = verify_resources(args.resources, data_dir)
+        core_manifest = verify_core(args.resources)
+        os.environ["NANOCHAT_BASE_DIR"] = str(args.resources.resolve())
+        tokenizer = RustBPETokenizer.from_directory(args.resources/"tokenizer")
+        if tokenizer.get_vocab_size() != config.vocab_size:
+            raise ValueError("model/tokenizer vocabulary mismatch")
+        source = runtime_source_manifest()
+        train_config = NativeTrainConfig()
+        p.validate_train_config(train_config)
+        model = build_model(config, device, seed=p.seed)
+        model.set_training_stage(0)
+        backend = plan["backend"]
+        from .methods.linear_backend import configure_linear_backend, linear_backend_provenance
+        configure_linear_backend(model, backend=backend)
+        backend_record = linear_backend_provenance(backend)
+        optimizer = build_optimizer(model, train_config)
+        stream = BestFitStream(data_dir, tokenizer, "train", rank, world, p.sequence_len,
+                               p.packing_buffer, p.tokenizer_batch_size)
+        update_cost = plan["theory_flops_per_update"]
+        calibration = json.loads(args.config.read_text()).get("calibration", {})
+        identity = dict(protocol_hash=p.fingerprint, model_hash=config.fingerprint,
+                        configuration_sha256=sha256(args.config), source_sha256=source["sha256"],
+                        data_manifest_sha256=manifest_hash, tokenizer_sha256=resources["tokenizer_sha256"],
+                        core_manifest_sha256=sha256(args.resources/"core_manifest.json"),
+                        mode=plan["mode"], backend=backend_record, torch=torch.__version__,
+                        precision_policy=precision_policy(model),
+                        micro_batch=args.micro_batch, world_size=world,
+                        theory_flops_per_update=update_cost)
+        identity_hash = digest_json(identity)
+        state = dict(step=0, budget=BudgetState().state_dict(), identity_hash=identity_hash,
+                     training_seconds=0., validation_seconds=0., core_seconds=0.,
+                     final_bpb_complete=False, mode=plan["mode"], bounded_eval_steps=[],
+                     next_global_sequence=0, evaluation_files={})
+        if args.resume:
+            saved = load_checkpoint(args.resume, model, optimizer, stream, rank, world)
+            if saved["model_config"] != asdict(config) or saved["train_config"] != asdict(train_config):
+                raise ValueError("resume model or optimizer/scheduler configuration differs")
+            state = saved["state"]
+            if state.get("identity_hash") != identity_hash or state.get("mode") != plan["mode"]:
+                raise ValueError("resume source/resource/backend/mode/batch fingerprint differs")
+            for name, checksum in state["evaluation_files"].items():
+                if not (output/name).is_file() or sha256(output/name) != checksum:
+                    raise ValueError("resume evaluation evidence missing or changed: "+name)
+            del saved
+        budget = BudgetState.from_state_dict(state["budget"])
+        check_cursor(budget, stream.rows, world, update_cost, complete_events=plan["mode"] == "formal")
+        if state["step"] != budget.optimizer_step or state["next_global_sequence"] != budget.input_tokens//p.sequence_len:
+            raise ValueError("checkpoint optimizer/global sequence cursor differs")
+        if budget.optimizer_step > plan["optimizer_steps"]:
+            raise ValueError("checkpoint is later than the requested bounded stop")
+        model.set_step(budget.optimizer_step)
+        wrapped = DDP(model, device_ids=[device.index], broadcast_buffers=False)
+        if rank == 0:
+            if args.resume:
+                archive_replay(output, budget.optimizer_step)
+            provenance = dict(identity=identity, identity_hash=identity_hash, plan=plan,
+                              model=asdict(config), train=asdict(train_config), source=source,
+                              calibration=calibration, cost_proof=proof, core_manifest=core_manifest,
+                              command=sys.argv, cuda=torch.version.cuda,
+                              device=torch.cuda.get_device_name(device),
+                              parameters=sum(t.numel() for t in model.parameters()),
+                              optimizer_groups=[{k:v for k,v in g.items() if k != "params"}
+                                                for g in optimizer.param_groups])
+            atomic_json(output/(f"resume_{budget.optimizer_step:08d}.json" if args.resume else "provenance.json"), provenance)
+
+        def emit(event):
+            if rank == 0:
+                append_event(output, event); print(json.dumps(event), flush=True)
+
+        def status(phase, **extra):
+            state.update(step=budget.optimizer_step, budget=budget.state_dict(),
+                         next_global_sequence=budget.input_tokens//p.sequence_len)
+            if rank == 0:
+                summary = {k:v for k,v in state.items() if k != "evaluation_files"}
+                atomic_json(output/"run_status.json", dict(phase=phase, **summary, **extra,
+                            protocol_hash=p.fingerprint, model_hash=config.fingerprint,
+                            input_tokens=budget.input_tokens, theory_flops=budget.theory_flops,
+                            updated_at=time.time()))
+
+        def save_evaluation(name, result):
+            receipt = [None]
+            if rank == 0:
+                atomic_json(output/name, result)
+                receipt[0] = sha256(output/name)
+            dist.broadcast_object_list(receipt, src=0)
+            state["evaluation_files"][name] = receipt[0]
+
+        val_tokens = p.val_tokens if plan["mode"] == "formal" else (
+            args.smoke_val_tokens or args.micro_batch*world*p.sequence_len)
+        if val_tokens % (args.micro_batch*world*p.sequence_len):
+            raise ValueError("evaluation tokens do not divide complete distributed batches")
+
+        def evaluate(kind):
+            # Evaluation is excluded from training tokens/FLOPs and cannot alter
+            # training's random state, data stream or keyed routing state.
+            saved_rng = rng_state()
+            try:
+                status("evaluating_"+kind)
+                if kind == "val":
+                    result = evaluate_bpb(model, tokenizer, data_dir, args.resources,
+                        batch=args.micro_batch, rank=rank, world=world, device=device,
+                        tokens=val_tokens, smoke=plan["mode"] != "formal")
+                    if not math.isfinite(result["bpb"]):
+                        raise ValueError("nonfinite validation BPB")
+                    state["validation_seconds"] += result["seconds"]
+                    if plan["mode"] == "formal":
+                        budget.record_eval("val"); prefix = "val"
+                    else:
+                        state["bounded_eval_steps"].append(budget.optimizer_step); prefix = plan["mode"]+"_bpb"
+                else:
+                    before = time.monotonic()
+                    result = evaluate_core(model, tokenizer, args.resources, device)
+                    validate_core_result(result)
+                    state["core_seconds"] += time.monotonic()-before
+                    budget.record_eval("core"); prefix = "core"
+                event = dict(event="validation" if kind == "val" else "core",
+                             step=budget.optimizer_step, mode=plan["mode"], **result)
+                save_evaluation(f"{prefix}_{budget.optimizer_step:08d}.json", event)
+                if kind == "core" and budget.optimizer_step == p.steps:
+                    save_evaluation("core_final.json", event)
+                emit(event)
+            finally:
+                restore_rng(saved_rng)
+
+        def due_events():
+            if plan["mode"] == "formal":
+                scheduled = events_at(budget.optimizer_step)
+                if scheduled["val"] and budget.optimizer_step not in budget.val_steps:
+                    evaluate("val")
+                if scheduled["core"] and budget.optimizer_step not in budget.core_steps:
+                    evaluate("core")
+            elif budget.optimizer_step in (0, plan["optimizer_steps"]) and budget.optimizer_step not in state["bounded_eval_steps"]:
+                evaluate("val")
+
+        model.train()
+        due_events()
+        rows_per_rank = plan["rows_per_rank"]
+        while budget.optimizer_step < plan["optimizer_steps"]:
+            step = budget.optimizer_step
+            model.set_step(step)
+            optimizer.zero_grad(set_to_none=True)
+            multiplier = set_schedule(optimizer, step, train_config)
+            synchronize(device); before = time.perf_counter(); data_seconds = 0.
+            torch.cuda.reset_peak_memory_stats(device)
+            sums = torch.zeros(4, device=device, dtype=torch.float64)
+            for micro in range(accumulation):
+                data_before = time.perf_counter()
+                x, y = stream.batch(args.micro_batch, device)
+                data_seconds += time.perf_counter()-data_before
+                expected_offset = step*(p.global_batch_tokens//p.sequence_len)+rank*rows_per_rank+micro*args.micro_batch
+                model.set_row_offset(expected_offset)
+                context = wrapped.no_sync() if micro < accumulation-1 else nullcontext()
+                with context, autocast(device):
+                    loss = wrapped(x, y)
+                    (loss/accumulation).backward()
+                n = x.numel()
+                sums[0] += model.last_lm_loss.detach().double()*n
+                sums[1] += model.last_aux_loss.detach().double()*n
+                sums[2] += loss.detach().double()*n
+                sums[3] += n
+            # Boolean validation adds no new gradient norm/rescaling algorithm.
+            # The scientific optimizer receives the unmodified DDP gradients.
+            if any(param.grad is None for param in model.parameters() if param.requires_grad):
+                raise RuntimeError("a trainable parameter has no gradient")
+            finite = torch.stack([torch.isfinite(param.grad).all() for param in model.parameters()
+                                  if param.requires_grad]).all()
+            if not bool(finite):
+                raise RuntimeError("nonfinite gradient")
+            synchronize(device); opt_before = time.perf_counter()
+            optimizer.step()
+            synchronize(device); opt_seconds = time.perf_counter()-opt_before
+            dist.all_reduce(sums)
+            values = sums.tolist()
+            if int(values[3]) != p.global_batch_tokens or not all(math.isfinite(x) for x in values[:3]):
+                raise RuntimeError("nonfinite objective or global input-token budget drift")
+            duration = time.perf_counter()-before
+            if update_cost is None:
+                budget.optimizer_step += 1; budget.input_tokens += p.global_batch_tokens
+                budget.validate()  # No theoretical cost is claimed by this pilot.
+            else:
+                budget.advance(p.global_batch_tokens, update_cost)
+            check_cursor(budget, stream.rows, world, update_cost, complete_events=False)
+            state["training_seconds"] += duration
+            status("training")
+            if budget.optimizer_step % args.log_every == 0 or step == 0 or budget.optimizer_step == plan["optimizer_steps"]:
+                dense = calibration.get("dense_flops_per_token")
+                deviation = None if dense is None or update_cost is None else update_cost/(p.global_batch_tokens*dense)-1
+                emit(dict(event="train", step=budget.optimizer_step, input_tokens=budget.input_tokens,
+                          mode=plan["mode"], lm_loss=values[0]/values[3], aux_loss=values[1]/values[3],
+                          loss=values[2]/values[3], gradients_finite=True, lr_multiplier=multiplier,
+                          step_seconds=duration, data_seconds=data_seconds, optimizer_seconds=opt_seconds,
+                          tokens_per_second=p.global_batch_tokens/duration,
+                          training_seconds=state["training_seconds"], gpu_hours=world*state["training_seconds"]/3600,
+                          theory_flops=budget.theory_flops if update_cost is not None else None,
+                          step_theory_flops=update_cost, theory_relative_error=deviation,
+                          rolling_budget_warning=deviation is not None and abs(deviation)>p.routing_warning,
+                          peak_memory_bytes=torch.cuda.max_memory_allocated(device)))
+            due_events()
+            if budget.optimizer_step % args.checkpoint_every == 0 and budget.optimizer_step != plan["optimizer_steps"]:
+                status("checkpointing")
+                save_checkpoint(output, model, optimizer, stream, config, train_config, state, rank, world)
+
+        if plan["mode"] == "formal" and not state["final_bpb_complete"]:
+            status("evaluating_final_bpb")
+            saved_rng = rng_state()
+            try:
+                final = {split:evaluate_bpb(model, tokenizer, data_dir, args.resources,
+                    batch=args.micro_batch, rank=rank, world=world, device=device,
+                    tokens=p.final_bpb_tokens, split=split) for split in ("train", "val")}
+                if not all(math.isfinite(item["bpb"]) for item in final.values()):
+                    raise ValueError("nonfinite final independent BPB")
+                save_evaluation("bpb_final.json", dict(step=p.steps, independent=True, **final))
+                emit(dict(event="final_bpb", step=p.steps, **{s+"_bpb":r["bpb"] for s,r in final.items()}))
+                state["final_bpb_complete"] = True
+            finally:
+                restore_rng(saved_rng)
+        # Refuse a moving implementation and verify resources at the end, too.
+        if runtime_source_manifest()["sha256"] != source["sha256"]:
+            raise ValueError("source changed during the run")
+        verify_resources(args.resources, data_dir); verify_core(args.resources)
+        for name, checksum in state["evaluation_files"].items():
+            if sha256(output/name) != checksum:
+                raise ValueError("evaluation evidence changed during run: "+name)
+        status("checkpointing")
+        final_checkpoint = output/f"checkpoint_{budget.optimizer_step:08d}"
+        if not (final_checkpoint/"complete.json").exists():
+            save_checkpoint(output, model, optimizer, stream, config, train_config, state, rank, world)
+        verdict = budget.final_status(calibration["dense_flops_per_token"]) if plan["mode"] == "formal" else "not_formal"
+        if plan["mode"] == "formal" and not state["final_bpb_complete"]:
+            verdict = "incomplete_eval"
+        phase = "training_complete" if plan["mode"] == "formal" else plan["mode"]+"_complete"
+        status(phase, budget_status=verdict, checkpoint=str(final_checkpoint),
+               final_core_complete=budget.core_steps == list(p.core_steps),
+               elapsed_this_invocation_seconds=time.monotonic()-started)
+        emit(dict(event="complete", step=budget.optimizer_step, phase=phase, budget_status=verdict))
+    except BaseException as exc:
+        if run_owned:
+            atomic_json(output/"failure.json", dict(error=repr(exc), at=time.time(), state=state,
+                                                    mode=plan["mode"], command=sys.argv))
+        raise
+    finally:
+        if dist.is_initialized():
+            dist.destroy_process_group()
+        if run_lock is not None:
+            run_lock.close()
+
+
+if __name__ == "__main__":
+    main()
