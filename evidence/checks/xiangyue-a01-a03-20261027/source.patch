+"""Bounded, admitted eight-GPU throughput check for A01/A02/A03.
+
+Uses synthetic rows and fresh random weights. It never saves a checkpoint or
+produces a model-quality result. Timing covers complete optimizer updates;
+parameter hashing and diagnostic collectives are outside the measured steps.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import nullcontext
+from datetime import datetime, timedelta, timezone
+import gc
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import statistics
+import time
+
+from .config import Protocol
+
+METHODS = ("deltanet", "gsa", "gla")
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--methods", nargs="+", choices=METHODS, default=list(METHODS))
+    parser.add_argument("--steps", type=int, default=8,
+                        help="total synthetic optimizer updates, including warmup; bounded at 64")
+    parser.add_argument("--warmup", type=int, default=2,
+                        help="initial measured updates excluded from steady statistics")
+    parser.add_argument("--micro-batch", type=int, default=16)
+    parser.add_argument("--backend", choices=("fla_fused",), default="fla_fused")
+    parser.add_argument("--config-dir", type=Path, required=True,
+                        help="new target-environment admitted configs and cost proofs")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    if not 1 <= args.steps <= 64 or not 0 <= args.warmup < args.steps:
+        parser.error("require 1 <= steps <= 64 and 0 <= warmup < steps")
+    if len(args.methods) != len(set(args.methods)):
+        parser.error("methods must be unique")
+    try:
+        Protocol().accumulation(args.micro_batch, 8)
+    except ValueError as error:
+        parser.error(str(error))
+    return args
+
+
+def steady_summary(records, warmup):
+    steady = [float(row["seconds"]) for row in records[warmup:]]
+    if not steady or not all(math.isfinite(value) and value > 0 for value in steady):
+        raise ValueError("steady timings must be positive and finite")
+    mean = statistics.mean(steady)
+    median = statistics.median(steady)
+    return dict(warmup_updates=warmup, steady_updates=len(steady),
+                steady_mean_seconds=mean, steady_median_seconds=median,
+                steady_min_seconds=min(steady), steady_max_seconds=max(steady),
+                steady_global_tokens_per_second=Protocol().global_batch_tokens/mean,
+                projected_train_compute_hours=Protocol().steps*mean/3600,
+                estimate_scope="synthetic_compute_only_excludes_real_data_and_evaluation")
+
+
+def _json_hash(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
+
+
+def _save(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    pending = path.with_name("."+path.name+"."+str(os.getpid())+".tmp")
+    pending.write_text(json.dumps(value, indent=2)+"\n")
+    pending.replace(path)
+
+
+def _parameter_digest(model):
+    import torch
+    result = hashlib.sha256()
+    for name, parameter in model.named_parameters():
+        result.update(name.encode())
+        result.update(parameter.detach().contiguous().view(torch.uint8).cpu().numpy().tobytes())
+    return result.hexdigest()
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    # Imports stay below argument handling so --help and parser regression do
+    # not need CUDA, FLA, torch.distributed, tokenizer or prepared resources.
+    import torch
+    rank = int(os.environ["RANK"])
+    world = int(os.environ["WORLD_SIZE"])
+    local = int(os.environ["LOCAL_RANK"])
+    if world != Protocol().data_parallel_size:
+        raise ValueError("benchmark requires exactly eight data-parallel ranks")
+    if not torch.cuda.is_available():
+        raise RuntimeError("benchmark requires CUDA BF16; no CPU fallback")
+    torch.cuda.set_device(local)
+    # Match the formal trainer's native initialize() policy before any model
+    # or optimizer kernels compile; this is also part of the recorded evidence.
+    torch.backends.cuda.matmul.allow_tf32 = True
+    torch.backends.cudnn.allow_tf32 = True
+    device = torch.device("cuda", local)
+    import torch.distributed as dist
+    from torch.nn.parallel import DistributedDataParallel as DDP
+    from nanochat.common import COMPUTE_DTYPE
+    from nanochat.native_experiment.config import NativeTrainConfig
+    from .calibrate import science_hash
+    from .methods.linear_backend import configure_linear_backend
+    from .model import build_model
+    from .optimizer import build_optimizer, set_schedule
+    from .protocol import admit_config
+
+    p = Protocol()
+    accumulation = p.accumulation(args.micro_batch, world)
+    if not torch.cuda.is_bf16_supported():
+        raise RuntimeError("benchmark requires CUDA BF16; no CPU fallback")
+    if COMPUTE_DTYPE != torch.bfloat16:
+        raise ValueError("set NANOCHAT_DTYPE=bfloat16 before process startup")
+    dist.init_process_group("nccl", device_id=device, timeout=timedelta(minutes=10))
+    torch.set_num_threads(2)
+    initial_science_hash = science_hash()
+    result = dict(
+        created_at=datetime.now(timezone.utc).isoformat(), status="running",
+        scope="full_dimensions_synthetic_complete_global_updates",
+        synthetic_data=True, formal_training=False, reusable_weights=False,
+        checkpoints_written=False, science_hash=initial_science_hash,
+        protocol_hash=p.fingerprint, torch=torch.__version__, cuda=torch.version.cuda,
+        dtype=str(COMPUTE_DTYPE), world_size=world,
+        precision_policy=dict(
+            compute_dtype=str(COMPUTE_DTYPE), autocast_dtype="torch.bfloat16",
+            recurrent_state_dtype="torch.float32",
+            matmul_allow_tf32=torch.backends.cuda.matmul.allow_tf32,
+            cudnn_allow_tf32=torch.backends.cudnn.allow_tf32,
+            float32_matmul_precision=torch.get_float32_matmul_precision(),
+        ),
+        device=torch.cuda.get_device_name(device), seed=p.seed,
+        requested_optimizer_updates=args.steps, warmup_updates=args.warmup,
+        micro_batch=args.micro_batch, accumulation=accumulation,
+        global_batch_tokens=p.global_batch_tokens, sequence_len=p.sequence_len,
+        methods=[],
+    )
+    owns_output = False
+    try:
+        if args.output.exists():
+            raise FileExistsError("preserve the existing benchmark record; choose a new output path")
+        dist.barrier(device_ids=[local])
+        if rank == 0:
+            _save(args.output, result)
+            owns_output = True
+        for method in args.methods:
+            config_path = args.config_dir/(method+".json")
+            config, proof = admit_config(config_path)
+            if (config.method != method or config.scale != "formal"
+                    or config.backend != args.backend):
+                raise ValueError("benchmark requires admitted full dimensions and the explicit frozen backend")
+            if (config.sequence_len != p.sequence_len or config.vocab_size != p.vocab_size
+                    or config.width != 1536 or config.heads != 12):
+                raise ValueError("benchmark may not reduce the common formal dimensions")
+            raw = json.loads(config_path.read_text())
+            proof_path = (config_path.parent/raw["calibration"]["cost_record"]).resolve()
+            proof_sha256 = hashlib.sha256(proof_path.read_bytes()).hexdigest()
+            model = build_model(config, device, seed=p.seed)
+            model.set_training_stage(0)
+            backend = configure_linear_backend(model, args.backend)
+            wrapper = DDP(model, device_ids=[local], broadcast_buffers=False)
+            train_config = NativeTrainConfig()
+            optimizer = build_optimizer(model, train_config)
+            # Whole-parameter hashes are deliberately outside every step timer.
+            before_hash = _parameter_digest(model)
+            method_result = dict(
+                method=method, status="running", synthetic_data=True,
+                formal_training=False, reusable_weights=False,
+                config_file=config_path.name,
+                config_sha256=hashlib.sha256(config_path.read_bytes()).hexdigest(),
+                model_hash=config.fingerprint, proof_sha256=proof_sha256,
+                proof_json_hash=_json_hash(proof), cost_formula=proof["formula_version"],
+                cost_science_hash=proof["source_hash"], backend=backend,
+                parameters=sum(parameter.numel() for parameter in model.parameters()),
+                micro_batch=args.micro_batch, accumulation=accumulation,
+                global_batch_tokens=p.global_batch_tokens, world_size=world,
+                input_shape=[args.micro_batch, p.sequence_len],
+                optimizer_updates=0, actual_input_tokens=0, steps=[],
+            )
+            result["methods"].append(method_result)
+            rows_per_rank = p.global_batch_tokens//p.sequence_len//world
+            row_positions = torch.arange(p.sequence_len+1, device=device)[None, :]
+            torch.cuda.reset_peak_memory_stats(device)
+            for step in range(args.steps):
+                dist.barrier(device_ids=[local])
+                torch.cuda.synchronize(device)
+                started = time.monotonic()
+                optimizer.zero_grad(set_to_none=True)
+                model.set_step(step)
+                set_schedule(optimizer, step, train_config)
+                loss_sum = torch.zeros((), device=device, dtype=torch.float32)
+                local_tokens = 0
+                for micro in range(accumulation):
+                    row_offset = step*512+rank*rows_per_rank+micro*args.micro_batch
+                    model.set_row_offset(row_offset)
+                    row_ids = torch.arange(row_offset, row_offset+args.micro_batch,
+                                           device=device)[:, None]
+                    data = (row_positions+row_ids*17+p.seed).remainder(config.vocab_size)
+                    x, y = data[:, :-1].contiguous(), data[:, 1:].contiguous()
+                    sync = wrapper.no_sync() if micro < accumulation-1 else nullcontext()
+                    with sync, torch.autocast(device_type="cuda", dtype=torch.bfloat16):
+                        loss = wrapper(x, y)/accumulation
+                        loss.backward()
+                    loss_sum += loss.detach().float()
+                    local_tokens += x.numel()
+                optimizer.step()
+                torch.cuda.synchronize(device)
+                seconds = time.monotonic()-started
+                # Timing records the slowest rank. Metric reductions, memory
+                # diagnostics and JSON writes are excluded from step seconds.
+                timing = torch.tensor(seconds, dtype=torch.float64, device=device)
+                dist.all_reduce(timing, op=dist.ReduceOp.MAX)
+                tokens = torch.tensor(local_tokens, dtype=torch.int64, device=device)
+                dist.all_reduce(tokens, op=dist.ReduceOp.SUM)
+                dist.all_reduce(loss_sum, op=dist.ReduceOp.SUM)
+                global_tokens, mean_loss = int(tokens), float(loss_sum/world)
+                if global_tokens != p.global_batch_tokens:
+                    raise RuntimeError("synthetic update changed the fixed global input budget")
+                if not math.isfinite(mean_loss):
+                    raise RuntimeError("nonfinite synthetic loss")
+                memory = torch.tensor([torch.cuda.max_memory_allocated(device),
+                                       torch.cuda.max_memory_reserved(device)],
+                                      dtype=torch.int64, device=device)
+                dist.all_reduce(memory, op=dist.ReduceOp.MAX)
+                event = dict(optimizer_step=step+1, seconds=float(timing), loss=mean_loss,
+                             loss_finite=True, global_input_tokens=global_tokens,
+                             cumulative_input_tokens=(step+1)*p.global_batch_tokens,
+                             warmup=step < args.warmup,
+                             peak_allocated_bytes=int(memory[0]),
+                             peak_reserved_bytes=int(memory[1]))
+                method_result["steps"].append(event)
+                method_result["optimizer_updates"] = step+1
+                method_result["actual_input_tokens"] = event["cumulative_input_tokens"]
+                if rank == 0:
+                    _save(args.output, result)
+                    print(json.dumps(dict(method=method, **event)), flush=True)
+            # Verify complete parameters across ranks after the final update;
+            # no CPU transfer or hashing cost is folded into steady timings.
+            after_hash = _parameter_digest(model)
+            hashes = [None]*world
+            dist.all_gather_object(hashes, after_hash)
+            if len(set(hashes)) != 1 or before_hash == after_hash:
+                raise RuntimeError("parameters did not change or are not identical across all eight ranks")
+            method_result.update(
+                status="passed", all_rank_parameters_equal=True,
+                parameters_changed=True, final_parameter_sha256=after_hash,
+                peak_allocated_bytes=max(item["peak_allocated_bytes"] for item in method_result["steps"]),
+                peak_reserved_bytes=max(item["peak_reserved_bytes"] for item in method_result["steps"]),
+                **steady_summary(method_result["steps"], args.warmup),
+            )
+            if science_hash() != initial_science_hash:
+                raise RuntimeError("scientific sources changed during benchmark")
+            if rank == 0:
+                _save(args.output, result)
+                print(json.dumps(dict(event="method_complete", **method_result)), flush=True)
+            del optimizer, wrapper, model, loss, loss_sum, x, y, data
+            gc.collect()
+            torch.cuda.empty_cache()
+            dist.barrier(device_ids=[local])
+        result["status"] = "passed"
+        result["completed_at"] = datetime.now(timezone.utc).isoformat()
+        if rank == 0 and owns_output:
+            _save(args.output, result)
+            print(json.dumps(dict(event="benchmark_complete", status="passed",
+                                  synthetic_data=True, reusable_weights=False)), flush=True)
+    except BaseException as error:
+        if rank == 0 and owns_output:
+            result["status"] = "failed"
+            result["error"] = dict(type=type(error).__name__, message=str(error))
+            _save(args.output, result)
+        raise
+    finally:
+        dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
