+"""Explicit, pinned FLA recurrent training backend for A01/A02/A03.
+
+The readable scan remains the default and numerical oracle. This adapter keeps
+the common projections, feature maps, convolution and output normalization in
+``linear.py``; it replaces only the recurrent state update/readout. It never
+silently falls back, never resets at BOS, and never carries state across rows.
+
+FLA's fused recurrent backward replays states. Its cost must be audited as this
+backend, not copied from the reference-autograd proof. No chunked/checkpointed
+kernel is selected here. Inputs and state arithmetic are FP32, matching the
+reference scan's accumulation policy; outputs are cast back to the input dtype.
+"""
+from functools import lru_cache
+import hashlib
+import importlib
+from pathlib import Path
+
+import torch
+
+
+BACKENDS = ("reference", "fla_fused")
+SUPPORTED_METHODS = ("deltanet", "gsa", "gla")
+FLA_COMMIT = "c885377e65a36f612bd10f57b7d1daa55224c31b"
+FLA_VERSION = "0.6.0"
+# SHA256 of relative path + NUL + content + NUL, sorted across fla/**/*.py.
+# The pin is the same upstream source snapshot documented in SOURCES.md.
+FLA_SOURCE_SHA256 = "18729a1590a253a66733572032b41eb1a6a94af7e6eeb07c9618c7b2a987635b"
+FLA_SOURCE_FILES = 562
+
+
+@lru_cache(maxsize=1)
+def _fla_runtime():
+    """Import lazily so ordinary CPU/reference use has no FLA dependency."""
+    fla = importlib.import_module("fla")
+    root = Path(fla.__file__).resolve().parent
+    files = sorted(root.rglob("*.py"))
+    digest = hashlib.sha256()
+    for path in files:
+        digest.update(path.relative_to(root).as_posix().encode())
+        digest.update(b"\0")
+        digest.update(path.read_bytes())
+        digest.update(b"\0")
+    actual = digest.hexdigest()
+    if (getattr(fla, "__version__", None) != FLA_VERSION
+            or len(files) != FLA_SOURCE_FILES or actual != FLA_SOURCE_SHA256):
+        raise RuntimeError(
+            "FLA source differs from the audited pin " + FLA_COMMIT
+            + "; install its exact source snapshot before selecting this backend"
+        )
+    from fla.ops.delta_rule import fused_recurrent_delta_rule
+    from fla.ops.gla import fused_recurrent_gla
+    from fla.ops.gsa import fused_recurrent_gsa
+    import triton
+    provenance = dict(
+        name="fla_fused", upstream="fla-org/flash-linear-attention",
+        upstream_commit=FLA_COMMIT, package_version=FLA_VERSION,
+        source_sha256=actual, source_files=len(files),
+        torch=torch.__version__, triton=triton.__version__,
+        state_precision="torch.float32", recurrent_inputs="torch.float32",
+        scale=1.0, state_reset="packed_row", backward="fused_with_state_replay",
+        chunked=False, activation_checkpointing=False,
+    )
+    return (fused_recurrent_delta_rule, fused_recurrent_gsa,
+            fused_recurrent_gla), provenance
+
+
+def linear_backend_provenance(backend="reference"):
+    if backend not in BACKENDS:
+        raise ValueError("unsupported linear backend: " + str(backend))
+    if backend == "reference":
+        return dict(name="reference", torch=torch.__version__,
+                    state_precision="torch.float32_for_low_precision_inputs",
+                    state_reset="packed_row", backward="pytorch_autograd")
+    return dict(_fla_runtime()[1])
+
+
+def configure_linear_backend(model, backend="reference"):
+    """Bind the trainer's explicit choice; config/proof must agree upstream.
+
+    Configuration admission is the trainer's responsibility. This function
+    rejects a different frozen config.backend, preventing a caller from using
+    a reference cost proof and then silently substituting the fused backend.
+    """
+    if backend not in BACKENDS:
+        raise ValueError("unsupported linear backend: " + str(backend))
+    if getattr(model.config, "backend", "reference") != backend:
+        raise ValueError("selected backend differs from the frozen model config")
+    from .linear import LinearMixer
+    mixers = [module for module in model.modules() if isinstance(module, LinearMixer)]
+    if not mixers:
+        raise ValueError("selected model does not contain linear mixers")
+    if backend != "reference" and any(m.kind not in SUPPORTED_METHODS for m in mixers):
+        raise ValueError("fused backend is audited only for A01 DeltaNet, A02 GSA and A03 GLA")
+    provenance = linear_backend_provenance(backend)
+    for module in mixers:
+        module.backend = backend
+    return provenance
+
+
+def fused_recurrent_attention(q, k, v, *, kind, decay=None, beta=None,
+                              slots=None, initial_state=None, eps=1e-6,
+                              output_final_state=False):
+    """Dispatch interface deliberately matches ``linear.recurrent_attention``.
+
+    Q is already scaled by the mixer for DeltaNet/GLA. GSA's address has no
+    sqrt(K) scaling in the mathematical reference, so all three pass scale=1.
+    FLA consumes log gates while the reference API consumes multiplicative
+    decay; the conversion and its gradient are ordinary, costed PyTorch ops.
+    """
+    if kind not in SUPPORTED_METHODS:
+        raise ValueError("fused backend does not implement " + str(kind))
+    if not q.is_cuda or not k.is_cuda or not v.is_cuda:
+        raise ValueError("fla_fused requires CUDA tensors")
+    if q.dtype not in (torch.float16, torch.bfloat16, torch.float32):
+        raise ValueError("FLA fused scan supports FP32/BF16/FP16, not an FP64 oracle")
+    if q.ndim != 4 or q.shape != k.shape or v.shape[:3] != q.shape[:3] or not q.shape[1]:
+        raise ValueError("expected nonempty [batch,time,head,feature] q/k/v")
+    if kind == "deltanet" and beta is None:
+        raise ValueError("DeltaNet requires beta")
+    if kind in ("gsa", "gla") and decay is None:
+        raise ValueError("gated scan requires multiplicative decay")
+    if kind == "gsa" and slots is None:
+        raise ValueError("GSA requires slot writes")
+    (delta, gsa, gla), _ = _fla_runtime()
+    dtype = q.dtype
+    # Disable caller autocast explicitly; both state updates and gradients use
+    # the reference FP32 accumulation path, not a hidden BF16 state policy.
+    with torch.autocast(device_type="cuda", enabled=False):
+        qf, kf, vf = (x.float().contiguous() for x in (q, k, v))
+        if initial_state is not None:
+            initial_state = (tuple(x.float().contiguous() for x in initial_state)
+                             if kind == "gsa" else initial_state.float().contiguous())
+        if kind == "deltanet":
+            output, state = delta(qf, kf, vf, beta=beta.float().contiguous(),
+                                  scale=1.0, initial_state=initial_state,
+                                  output_final_state=output_final_state,
+                                  use_qk_l2norm_in_kernel=False)
+        else:
+            log_decay = decay.float().log().contiguous()
+            if kind == "gla":
+                output, state = gla(qf, kf, vf, gk=log_decay, scale=1.0,
+                                     initial_state=initial_state,
+                                     output_final_state=output_final_state)
+            else:
+                output, state = gsa(qf, kf, vf, s=slots.float().contiguous(),
+                                     g=log_decay, scale=1.0,
+                                     initial_state=initial_state,
+                                     output_final_state=output_final_state)
+    return output.to(dtype), state
